/* esp32-basic devicetree overlay
 * Demonstrates how to enable and alias GPIO, ADC and PWM devices.
 * Adjust pin numbers to match your board variant.
 */

//#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
    aliases {
        /* led0 should alias the LED node label, not the gpio controller */
        userled = &led0;
				userswitch = &btn0;
        useradc = &adc0;
        useradcch = &adc0_ch1;

				gnss = &gnss;
				mpu9250 = &mpu9250;
				bme280 = &bme280;
				ms5607 = &ms5607;
    };

    leds {
        compatible = "gpio-leds";
        led0: d13 {
            gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
        };
    };

		buttons {
        compatible = "gpio-keys";
        debounce-interval-ms = <50>;
        polling-mode;

        btn0: d10 {
            gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
        };
    };
};

&gpio0 {
    status = "okay";
};


&uart1 {
		status = "okay";
		current-speed = <9600>;
    pinctrl-0 = <&uart1_pins>;
    pinctrl-names = "default";

		gnss: u_blox_m8 {
			status = "okay";
			compatible = "u-blox,m8";
			initial-baudrate = <9600>;
		};
};


&i2c0 {
		status = "okay"; // DEFAULT: pin 8 (SDA), pin 9 (SCL) 
		pinctrl-0 = <&i2c0_pins>;
		pinctrl-names = "default";

		mpu9250: mpu9250@68 {
				compatible = "invensense,mpu9250";
				gyro-sr-div = <5>; // rate = sample_rate / (1 + gyro-sr-div)
				gyro-dlpf = <250>;
				gyro-fs = <500>;
				accel-fs = <2>;
				accel-dlpf = "218.1";
				reg = <0x68>;
		};

    ms5607: ms5607@77 {
        compatible = "meas,ms5607";
        reg = <0x77>;
    };

		bme280: bme280@76 {
				compatible = "bosch,bme280";
				reg = <0x76>;
		};
};

&adc0 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    adc0_ch1: channel@1 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,vref-mv = <3894>;
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
};

&pinctrl {
	uart1_pins: uart1_pins {
		group1 {
			pinmux = <UART1_TX_GPIO17>;
			output-high;
		};
		group2 {
			pinmux = <UART1_RX_GPIO18>;
			bias-pull-up;
		};
	};

  i2c0_pins: i2c0_pins {
      group1 {
          pinmux = <
              I2C0_SDA_GPIO35
              I2C0_SCL_GPIO36
          >;
      };
  };
};

